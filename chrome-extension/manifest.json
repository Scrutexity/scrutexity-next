{
  "manifest_version": 3,
  "name": "Scrutexity — Claim Receipt",
  "version": "0.1.0",
  "description": "Audit live claims before publish. Verify your page against regulatory and competitive risk in seconds.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claim Receipt"
  },
  "icons": {
    "16": "/images/icon-16.png",
    "48": "/images/icon-48.png",
    "128": "/images/icon-128.png"
  }
}
